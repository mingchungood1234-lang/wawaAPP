# Copy to .env and fill in.
APP_PASSWORD=change-me-to-a-long-random-password
PUSH_CONTACT=mailto:you@example.com
# Local port the app listens on (127.0.0.1 only); nginx forwards here. Change if 3000 is taken.
APP_PORT=3000
# Low-RAM tuning (1 GB VPS). In-memory cache for downloaded media, and max upload size.
MEDIA_CACHE_MB=24
UPLOAD_LIMIT_MB=32
